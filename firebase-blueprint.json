{
  "entities": {
    "user": {
      "title": "User",
      "description": "User profile containing personal and professional data.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "artisticName": { "type": "string" },
        "role": { "type": "string", "enum": ["Aluno", "Professor", "Gestor"] },
        "cpf": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "bank": { "type": "string" },
        "bankAgency": { "type": "string" },
        "bankAccount": { "type": "string" },
        "pixKey": { "type": "string" },
        "cnpj": { "type": "string" },
        "photo": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "role", "cpf", "email"]
    },
    "class": {
      "title": "Class",
      "description": "A theater class or course group.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "code": { "type": "string" },
        "weekday": { "type": "string" },
        "time": { "type": "string" },
        "startDate": { "type": "string" },
        "teacherId": { "type": "string" },
        "studentIds": { "type": "array", "items": { "type": "string" } },
        "enrollmentDates": { "type": "object", "additionalProperties": { "type": "string" } },
        "isActive": { "type": "boolean" },
        "inactivationReason": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "code", "weekday", "time", "startDate", "isActive"]
    },
    "autoavaliacao": {
      "title": "Self-Assessment",
      "description": "Monthly student self-assessment.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "classId": { "type": "string" },
        "classType": { "type": "string" },
        "month": { "type": "number" },
        "year": { "type": "number" },
        "notes": { 
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0, "maximum": 10 }
        },
        "openAnswers": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentId", "classId", "month", "year", "notes"]
    },
    "diario_classe": {
      "title": "Class Diary",
      "description": "Monthly pedagogical monitoring and student evaluation by professors.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "classId": { "type": "string" },
        "className": { "type": "string" },
        "classType": { "type": "string" },
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "month": { "type": "number" },
        "year": { "type": "number" },
        "presences": { "type": "number", "minimum": 0 },
        "absences": { "type": "number", "minimum": 0 },
        "frequencyObs": { "type": "string" },
        "grades": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0, "maximum": 10 }
        },
        "criteriaObs": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "generalPedagogicalObs": { "type": "string" },
        "averageGrade": { "type": "number" },
        "status": { "type": "string", "enum": ["rascunho", "concluido"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentId", "classId", "teacherId", "month", "year", "status"]
    },
    "evolucao": {
      "title": "Student Evolution",
      "description": "Monthly evolution record calculating weighted averages between self-assessment and teacher evaluation.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "classId": { "type": "string" },
        "className": { "type": "string" },
        "classType": { "type": "string" },
        "month": { "type": "number" },
        "year": { "type": "number" },
        "mediaAutoavaliacao": { "type": "number" },
        "mediaAvaliacaoProfessor": { "type": "number" },
        "pesoAutoavaliacao": { "type": "number" },
        "pesoAvaliacaoProfessor": { "type": "number" },
        "mediaFinalEvolucao": { "type": "number" },
        "statusEvolucao": { "type": "string", "enum": ["Aguardando dados", "Aguardando autoavaliação", "Aguardando avaliação do professor", "Concluída"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentId", "classId", "month", "year", "statusEvolucao"]
    }
  },
  "firestore": {
    "/usuarios/{userId}": {
      "schema": "user",
      "description": "Profiles of all users."
    },
    "/classes/{classId}": {
      "schema": "class",
      "description": "Details of theater classes."
    },
    "/autoavaliacoes/{assessmentId}": {
      "schema": "autoavaliacao",
      "description": "Student self-assessments records."
    },
    "/diarios_classe/{diaryId}": {
      "schema": "diario_classe",
      "description": "Monthly pedagogical diaries filled by professors."
    },
    "/evolucao/{evolId}": {
      "schema": "evolucao",
      "description": "Calculated student evolution records."
    }
  }
}
