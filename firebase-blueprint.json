{
  "entities": {
    "User": {
      "title": "Usuário",
      "description": "Perfil de usuário no sistema (Aluno, Professor ou Gestor)",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "artisticName": { "type": "string" },
        "birthDate": { "type": "string", "format": "date" },
        "role": { "type": "string", "enum": ["Aluno", "Professor", "Gestor"] },
        "cpf": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "photo": { "type": "string" },
        "passwordChanged": { "type": "boolean" },
        "username": { "type": "string" },
        "bank": { "type": "string" },
        "bankAgency": { "type": "string" },
        "bankAccount": { "type": "string" },
        "pixKey": { "type": "string" },
        "cnpj": { "type": "string" },
        "createdAt": { "type": "object" },
        "updatedAt": { "type": "object" }
      },
      "required": ["name", "email", "role"]
    },
    "Class": {
      "title": "Turma",
      "description": "Informações sobre uma turma de aula",
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "code": { "type": "string" },
        "weekday": { "type": "string" },
        "time": { "type": "string" },
        "startDate": { "type": "string" },
        "year": { "type": "string" },
        "isActive": { "type": "boolean" },
        "inactivationReason": { "type": "string" },
        "teacherId": { "type": "string" },
        "studentIds": { "type": "array", "items": { "type": "string" } },
        "enrollmentDates": { "type": "object", "additionalProperties": { "type": "string" } },
        "createdAt": { "type": "object" },
        "updatedAt": { "type": "object" }
      },
      "required": ["code", "type", "isActive"]
    },
    "Evaluation": {
      "title": "Autoanálise",
      "description": "Autoanálise mensal enviada pelo aluno",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "studentEmail": { "type": "string" },
        "classId": { "type": "string" },
        "classType": { "type": "string" },
        "month": { "type": "number" },
        "year": { "type": "number" },
        "notes": { "type": "object" },
        "openAnswers": { "type": "object" },
        "pedagogicalAnalysis": {
          "type": "object",
          "properties": {
            "status_turma": {
              "type": "object",
              "properties": {
                "clima_emocional": { "type": "string" },
                "nivel_engajamento": { "type": "string", "enum": ["alto", "medio", "baixo"] }
              }
            },
            "pilares_individuais": {
              "type": "object",
              "properties": {
                "acolhimento": { "type": "string", "enum": ["baixo", "medio", "alto"] },
                "presenca": { "type": "string", "enum": ["baixo", "medio", "alto"] },
                "desafio": { "type": "string", "enum": ["baixo", "medio", "alto"] },
                "clareza": { "type": "string", "enum": ["baixo", "medio", "alto"] },
                "coletividade": { "type": "string", "enum": ["baixo", "medio", "alto"] }
              }
            },
            "analise_qualitativa": { "type": "string" },
            "alerta_coordenacao": { "type": "boolean" }
          }
        },
        "createdAt": { "type": "object" },
        "updatedAt": { "type": "object" }
      },
      "required": ["studentId", "classId", "month", "year"]
    },
    "Diary": {
      "title": "Diário de Classe",
      "description": "Registro pedagógico mensal de um aluno em uma turma",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "studentEmail": { "type": "string" },
        "classId": { "type": "string" },
        "className": { "type": "string" },
        "classType": { "type": "string" },
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "month": { "type": "number" },
        "year": { "type": "number" },
        "presences": { "type": "number" },
        "absences": { "type": "number" },
        "frequencyObs": { "type": "string" },
        "weeklyAttendance": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "status": { "type": "string", "enum": ["presente", "falta"] },
              "comment": { "type": "string" },
              "date": { "type": "string" }
            }
          }
        },
        "grades": { "type": "object" },
        "criteriaObs": { "type": "object" },
        "generalPedagogicalObs": { "type": "string" },
        "averageGrade": { "type": "number" },
        "status": { "type": "string", "enum": ["rascunho", "concluido"] },
        "createdAt": { "type": "object" },
        "updatedAt": { "type": "object" }
      },
      "required": ["studentId", "classId", "teacherId", "month", "year", "status"]
    },
    "Evolution": {
      "title": "Evolução",
      "description": "Registro extra de evolução do aluno",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "classId": { "type": "string" },
        "teacherId": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "object" }
      },
      "required": ["studentId", "classId", "teacherId"]
    },
    "Announcement": {
      "title": "Aviso",
      "description": "Avisos enviados pelo gestor para os usuários",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "target": { "type": "string", "enum": ["Todos", "Alunos", "Professores"] },
        "targetSpecificUsers": { "type": "boolean" },
        "targetUserIds": { "type": "array", "items": { "type": "string" } },
        "scheduledFor": { "type": "object" },
        "createdBy": { "type": "string" },
        "likes": { "type": "array", "items": { "type": "string" } },
        "forces": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "object" },
        "updatedAt": { "type": "object" }
      },
      "required": ["title", "content", "target"]
    },
    "Post": {
      "title": "Post do Mural",
      "description": "Postagem no mural social da turma",
      "type": "object",
      "properties": {
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "classId": { "type": "string" },
        "content": { "type": "string" },
        "imageUrl": { "type": "string" },
        "likes": { "type": "array", "items": { "type": "string" } },
        "forces": { "type": "array", "items": { "type": "string" } },
        "timestamp": { "type": "object" }
      },
      "required": ["authorId", "classId", "content", "timestamp"]
    },
    "Badge": {
      "title": "Conquista",
      "description": "Definição de uma conquista/badge no sistema",
      "type": "object",
      "properties": {
        "badgeId": { "type": "string" },
        "name": { "type": "string" },
        "icon": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" }
      },
      "required": ["badgeId", "name", "icon", "description"]
    },
    "UserBadge": {
      "title": "Conquista do Usuário",
      "description": "Uma conquista atribuída a um usuário específico",
      "type": "object",
      "properties": {
        "badgeId": { "type": "string" },
        "name": { "type": "string" },
        "icon": { "type": "string" },
        "description": { "type": "string" },
        "dateReceived": { "type": "object" },
        "message": { "type": "string" }
      },
      "required": ["badgeId", "dateReceived", "message"]
    },
    "SchoolEvent": {
      "title": "Evento da Escola",
      "description": "Agenda de ensaios, peças e workshops",
      "type": "object",
      "properties": {
        "titulo": { "type": "string" },
        "tipo": { "type": "string", "enum": ["Ensaio", "Peça", "Workshop", "Aula Aberta"] },
        "data": { "type": "object" },
        "inicio": { "type": "string" },
        "fim": { "type": "string" },
        "local": { "type": "string" },
        "descricao": { "type": "string" },
        "obrigatorio": { "type": "boolean" },
        "criadoPor": { "type": "string" },
        "lastUpdate": { "type": "object" }
      },
      "required": ["titulo", "tipo", "data", "inicio", "fim", "local"]
    },
    "ClassFeedback": {
      "title": "Feedback de Aula",
      "description": "Percepção do aluno sobre uma aula específica",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "classId": { "type": "string" },
        "className": { "type": "string" },
        "date": { "type": "object" },
        "rating": { "type": "number", "minimum": 1, "maximum": 5 },
        "comment": { "type": "string" },
        "timestamp": { "type": "object" }
      },
      "required": ["studentId", "studentName", "classId", "rating"]
    },
    "PedagogicalMeetingRequest": {
      "title": "Solicitação de Agendamento Pedagógico",
      "description": "Solicitação de reunião entre aluno e professor para discutir notas",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "teacherId": { "type": "string" },
        "classId": { "type": "string" },
        "className": { "type": "string" },
        "status": { "type": "string", "enum": ["Pendente", "Agendado", "Concluído"] },
        "requestDate": { "type": "object" },
        "timestamp": { "type": "object" }
      },
      "required": ["studentId", "studentName", "classId", "status"]
    }
  },
  "firestore": {
    "pedagogical-requests/{requestId}": {
      "schema": "PedagogicalMeetingRequest",
      "description": "Solicitações de agendamento pedagógico"
    },
    "feedbacks-aulas/{feedbackId}": {
      "schema": "ClassFeedback",
      "description": "Coleção de feedbacks de aulas enviados pelos alunos"
    },
    "eventos-escola/{eventId}": {
      "schema": "SchoolEvent",
      "description": "Coleção de eventos e ensaios da escola"
    },
    "usuarios/{userId}": {
      "schema": "User",
      "description": "Coleção de usuários"
    },
    "usuarios/{userId}/userBadges/{badgeId}": {
      "schema": "UserBadge",
      "description": "Subcoleção de conquistas conquistadas pelo usuário"
    },
    "badges/{badgeId}": {
      "schema": "Badge",
      "description": "Coleção de definições de conquistas"
    },
    "classes/{classId}": {
      "schema": "Class",
      "description": "Coleção de turmas"
    },
    "autoavaliacoes/{evalId}": {
      "schema": "Evaluation",
      "description": "Coleção de autoanálises"
    },
    "diarios_classe/{diaryId}": {
      "schema": "Diary",
      "description": "Coleção de diários de classe"
    },
    "evolucao/{evId}": {
      "schema": "Evolution",
      "description": "Coleção de registros de evolução"
    },
    "avisos/{avisoId}": {
      "schema": "Announcement",
      "description": "Coleção de avisos"
    },
    "posts/{postId}": {
      "schema": "Post",
      "description": "Coleção de postagens do mural"
    }
  }
}
