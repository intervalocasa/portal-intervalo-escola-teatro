rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Auth-based role checks (using get() on trusted usuarios collection)
    function getAuthUser() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    
    function isGestor() {
      return isVerified() && (
        (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) && getAuthUser().role == 'Gestor') ||
        request.auth.token.email == 'intervalocasa@gmail.com'
      );
    }

    function isTeacher() {
      return isVerified() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) && getAuthUser().role == 'Professor';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Collection: Usuarios ---
    match /usuarios/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['name', 'role', 'cpf', 'email']) &&
               data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
               data.role in ['Aluno', 'Professor', 'Gestor'] &&
               data.cpf is string && data.cpf.size() <= 20 &&
               data.email is string && data.email.size() <= 100 &&
               (data.artisticName == null || (data.artisticName is string && data.artisticName.size() <= 200)) &&
               (data.phone == null || (data.phone is string && data.phone.size() <= 30)) &&
               (data.address == null || (data.address is string && data.address.size() <= 500));
      }

      // Read access: Only Gestores or the owner can read profile details.
      // PII Isolation: Bank details are in the same doc, so we must be strict.
      allow get: if isVerified() && (isOwner(userId) || isGestor());
      // List: Only Gestores can list users.
      allow list: if isVerified() && isGestor();

      // Create: Gestores can create any user. Users can create their own profile during registration.
      allow create: if isVerified() && 
                    (isGestor() || isOwner(userId)) && 
                    isValidId(userId) && 
                    isValidUser(incoming());

      // Update: Split into actions
      allow update: if isVerified() && isValidUser(incoming()) && (
        // Action: Gestor full update
        isGestor() ||
        // Action: Profile update (restricted fields)
        (isOwner(userId) && 
         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'artisticName', 'photo', 'email', 'phone', 'address', 'password', 'bank', 'bankAgency', 'bankAccount', 'pixKey', 'cnpj', 'updatedAt']) &&
         incoming().role == existing().role &&
         incoming().cpf == existing().cpf)
      );

      allow delete: if isVerified() && isGestor();
    }

    // --- Collection: Classes ---
    match /classes/{classId} {
      function isValidClass(data) {
        return data.keys().hasAll(['type', 'code', 'weekday', 'time', 'startDate', 'isActive']) &&
               data.type is string && data.type.size() <= 100 &&
               data.code is string && data.code.size() <= 50 &&
               data.weekday is string && data.weekday.size() <= 20 &&
               data.time is string && data.time.size() <= 10 &&
               data.startDate is string && data.startDate.size() <= 20 &&
               data.isActive is bool;
      }

      allow read: if isVerified();
      allow list: if isVerified();

      allow create: if isVerified() && isGestor() && isValidId(classId) && isValidClass(incoming());
      allow update: if isVerified() && isGestor() && isValidClass(incoming());
      allow delete: if isVerified() && isGestor();
    }

    // --- Collection: Autoavaliacoes ---
    match /autoavaliacoes/{assessmentId} {
      function isValidAssessment(data) {
        return data.keys().hasAll(['studentId', 'studentName', 'classId', 'classType', 'month', 'year', 'notes', 'updatedAt']) &&
               data.studentId is string && isValidId(data.studentId) &&
               data.classId is string && isValidId(data.classId) &&
               data.month is number && data.month >= 1 && data.month <= 12 &&
               data.year is number &&
               data.notes is map &&
               data.updatedAt is timestamp;
      }

      allow get: if isVerified() && (isOwner(existing().studentId) || isGestor());
      // Secure List: Rule enforces that users only query their own assessments.
      allow list: if isVerified() && (isGestor() || resource.data.studentId == request.auth.uid);

      allow create: if isVerified() && 
                    isOwner(incoming().studentId) && 
                    isValidId(assessmentId) && 
                    isValidAssessment(incoming()) &&
                    incoming().createdAt == request.time;
      
      allow update: if isVerified() && 
                    isOwner(existing().studentId) && 
                    isValidAssessment(incoming()) &&
                    incoming().studentId == existing().studentId &&
                    incoming().classId == existing().classId &&
                    incoming().month == existing().month &&
                    incoming().year == existing().year;

      allow delete: if isVerified() && isGestor();
    }

    // --- Collection: Diarios de Classe ---
    match /diarios_classe/{diaryId} {
      function isValidDiary(data) {
        return data.keys().hasAll(['studentId', 'classId', 'teacherId', 'month', 'year', 'status']) &&
               data.studentId is string && isValidId(data.studentId) &&
               data.classId is string && isValidId(data.classId) &&
               data.teacherId is string && isValidId(data.teacherId) &&
               data.month is number && data.month >= 1 && data.month <= 12 &&
               data.year is number &&
               data.status in ['rascunho', 'concluido'];
      }

      function isClassTeacher(data) {
        return isVerified() && data.teacherId == request.auth.uid;
      }

      // Students need to see their own diaries for evolution
      allow get: if isVerified() && (isClassTeacher(existing()) || isGestor() || existing().studentId == request.auth.uid);
      allow list: if isVerified() && (isGestor() || resource.data.teacherId == request.auth.uid || resource.data.studentId == request.auth.uid);

      allow create: if isVerified() && 
                    (isClassTeacher(incoming()) || isGestor()) && 
                    isValidId(diaryId) && 
                    isValidDiary(incoming()) &&
                    incoming().createdAt == request.time;
      
      allow update: if isVerified() && 
                    (isClassTeacher(incoming()) || isGestor()) && 
                    isValidDiary(incoming()) &&
                    incoming().updatedAt == request.time;
      
      allow delete: if isVerified() && isGestor();
    }

    // --- Collection: Evolucao ---
    match /evolucao/{evolId} {
      function isValidEvolucao(data) {
        return data.keys().hasAll(['studentId', 'classId', 'month', 'year', 'statusEvolucao']) &&
               data.studentId is string && isValidId(data.studentId) &&
               data.classId is string && isValidId(data.classId) &&
               data.month is number && data.month >= 1 && data.month <= 12 &&
               data.year is number &&
               data.statusEvolucao in ['Aguardando dados', 'Aguardando autoavaliação', 'Aguardando avaliação do professor', 'Concluída'];
      }

      allow get: if isVerified() && (resource.data.studentId == request.auth.uid || isGestor());
      allow list: if isVerified() && (isGestor() || (resource.data.studentId == request.auth.uid));

      allow create: if isVerified() && 
                    (incoming().studentId == request.auth.uid || isGestor()) && 
                    isValidId(evolId) && 
                    isValidEvolucao(incoming()) &&
                    incoming().createdAt == request.time;
      
      allow update: if isVerified() && 
                    (resource.data.studentId == request.auth.uid || isGestor()) && 
                    isValidEvolucao(incoming()) &&
                    incoming().updatedAt == request.time;
      
      allow delete: if isVerified() && isGestor();
    }
  }
}

