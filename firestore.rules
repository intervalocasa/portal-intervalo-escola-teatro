rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserRole() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role;
    }
    
    function isGestor() {
      return isSignedIn() && (getUserRole() == 'Gestor' || request.auth.token.email == 'intervalocasa@gmail.com');
    }
    
    function isProfessor() {
      return isSignedIn() && getUserRole() == 'Professor';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200
          && data.email is string && data.email.size() <= 100
          && (data.photo == null || (data.photo is string && data.photo.size() <= 1500000));
    }

    match /usuarios/{userId} {
      // Allow read for everyone to support the "First Access" email check
      allow read: if true;
      allow create: if true; // Allow users to create their own profile on first login
      allow update: if isSignedIn(); // Allow any signed in user to update their own data during migration
      allow delete: if isGestor();
    }

    match /classes/{classId} {
      allow read: if true;
      allow write: if isSignedIn(); // Allow users to update their IDs during migration
    }

    match /autoavaliacoes/{evalId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isGestor();
    }

    match /diarios_classe/{diaryId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /evolucao/{evId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /system/{docId} {
      allow read: if true;
    }
  }
}
