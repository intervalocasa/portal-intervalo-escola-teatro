rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserRole() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role;
    }
    
    function isGestor() {
      return isSignedIn() && (getUserRole() == 'Gestor' || getUserRole() == 'Diretor Pedagógico' || getUserRole() == 'Diretor Pedagógico e Professor' || request.auth.token.email == 'intervalocasa@gmail.com');
    }
    
    function isProfessor() {
      return isSignedIn() && (getUserRole() == 'Professor' || getUserRole() == 'Diretor Pedagógico e Professor');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidPost(data) {
      return data.authorId is string && data.authorId == request.auth.uid
          && data.classId is string && data.classId.size() > 0
          && data.content is string && data.content.size() <= 2000
          && data.get('likes', []) is list
          && (data.get('forces', []) is list)
          && (data.get('imageUrl', null) == null || (data.imageUrl is string && data.imageUrl.size() <= 5000));
    }

    function isValidUser(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200
          && data.email is string && data.email.size() <= 100
          && (data.photo == null || (data.photo is string && data.photo.size() <= 1500000));
    }

    match /usuarios/{userId} {
      // Allow read, create, and update for everyone to support login, password setup, and credential sync
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isGestor();

      match /userBadges/{badgeId} {
        allow read: if true;
        allow write: if isGestor() || isProfessor();
      }
    }

    match /badges/{badgeId} {
      allow read: if true;
      allow write: if isGestor();
    }

    match /classes/{classId} {
      allow read: if true;
      allow write: if isSignedIn(); // Allow users to update their IDs during migration
    }

    match /autoavaliacoes/{evalId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isGestor();
    }

    match /diarios_classe/{diaryId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /evolucao/{evId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidPost(request.resource.data);
      allow update: if isSignedIn() && (
        isValidPost(request.resource.data) && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'forces'])
          || resource.data.authorId == request.auth.uid 
          || isGestor()
        )
      );
      allow delete: if isGestor() || (isSignedIn() && resource.data.authorId == request.auth.uid);
    }

    match /avisos/{avisoId} {
      allow read: if isSignedIn();
      allow create: if isGestor();
      allow update: if isGestor() || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'forces', 'lido']));
      allow delete: if isGestor();
    }

    match /eventos-escola/{eventId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isGestor();
    }

    match /feedbacks-aulas/{feedbackId} {
      allow read: if isGestor() || (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid;
      allow delete: if isGestor();
    }

    match /pedagogical-requests/{requestId} {
      allow read: if isGestor() || (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if isGestor();
    }

    match /system/{docId} {
      allow read: if true;
    }
  }
}
