rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserRole() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role;
    }
    
    function isGestor() {
      return isSignedIn() && (getUserRole() == 'Gestor' || request.auth.token.email == 'intervalocasa@gmail.com');
    }
    
    function isProfessor() {
      return isSignedIn() && getUserRole() == 'Professor';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200
          && data.email is string && data.email.size() <= 100
          && (data.photo == null || (data.photo is string && data.photo.size() <= 1500000)); // ~1.5MB for base64
    }

    match /usuarios/{userId} {
      allow read: if isSignedIn();
      allow create: if isGestor();
      allow update: if isGestor() || (
        isOwner(userId) && isValidUser(request.resource.data)
        && request.resource.data.role == resource.data.role // Cannot change own role
      );
      allow delete: if isGestor();
    }

    match /classes/{classId} {
      allow read: if isSignedIn();
      allow write: if isGestor();
    }

    match /autoavaliacoes/{evalId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid;
      allow update: if isGestor() || (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow delete: if isGestor();
    }

    match /diarios_classe/{diaryId} {
      allow read: if isSignedIn();
      allow write: if isGestor() || isProfessor();
    }

    match /evolucao/{evId} {
      allow read: if isSignedIn();
      allow write: if isGestor() || isProfessor();
    }

    match /system/{docId} {
      allow read: if true;
    }
  }
}
